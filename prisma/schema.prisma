generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum TeamRole {
  VIEWER
  UPLOADER
  EDITOR
}

model team_spaces {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(500)
  owner_id String @db.Uuid
  root_folder_id String @unique @db.Uuid
  is_public Boolean @default(false)
  join_password_hash String?
  invite_token String? @unique @db.VarChar(43)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  owner users @relation("OwnedTeams", fields: [owner_id], references: [id], onDelete: Cascade)
  root folders @relation(fields: [root_folder_id], references: [id], onDelete: Cascade)
  members team_members[]
  invitations team_invitations[]
  messages team_messages[]
  chat_reads team_chat_reads[]
  tasks team_tasks[]
  reviews team_file_reviews[]
  @@index([owner_id, created_at])
  @@index([is_public, created_at, id])
}

model team_members {
  team_id String @db.Uuid
  user_id String @db.Uuid
  role TeamRole @default(VIEWER)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  team team_spaces @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user users @relation("TeamMemberships", fields: [user_id], references: [id], onDelete: Cascade)
  @@id([team_id, user_id])
  @@index([user_id, team_id])
}

model team_invitations {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id String @db.Uuid
  user_id String @db.Uuid
  role TeamRole
  created_at DateTime @default(now()) @db.Timestamptz(6)
  team team_spaces @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@unique([team_id, user_id])
  @@index([user_id, created_at])
}

model team_messages {
  id BigInt @id @default(autoincrement())
  team_id String @db.Uuid
  author_id String? @db.Uuid
  request_id String @db.Uuid
  body String @db.VarChar(2000)
  reply_to_id BigInt?
  file_id String? @db.Uuid
  pinned_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  team team_spaces @relation(fields: [team_id], references: [id], onDelete: Cascade)
  author users? @relation(fields: [author_id], references: [id], onDelete: SetNull)
  file files? @relation(fields: [file_id], references: [id], onDelete: SetNull)
  reply_to team_messages? @relation("TeamMessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies team_messages[] @relation("TeamMessageReplies")
  mentions team_chat_mentions[]
  task team_tasks?
  @@unique([team_id, request_id])
  @@index([team_id, id])
  @@index([author_id])
  @@index([file_id])
  @@index([reply_to_id])
  @@index([team_id, pinned_at])
}

model team_chat_reads {
  team_id String @db.Uuid
  user_id String @db.Uuid
  last_read_id BigInt
  team team_spaces @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@id([team_id, user_id])
  @@index([user_id, team_id])
}

model team_chat_mentions {
  message_id BigInt
  user_id String @db.Uuid
  message team_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@id([message_id, user_id])
  @@index([user_id, message_id])
}

model team_tasks {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id String @db.Uuid
  message_id BigInt @unique
  created_by_id String? @db.Uuid
  assignee_id String? @db.Uuid
  title String @db.VarChar(160)
  due_on DateTime @db.Date
  created_at DateTime @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  team team_spaces @relation(fields: [team_id], references: [id], onDelete: Cascade)
  message team_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  creator users? @relation("TeamTaskCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  assignee users? @relation("TeamTaskAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  @@index([team_id, created_at, id])
  @@index([created_by_id])
  @@index([assignee_id])
}

enum TeamReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model team_file_reviews {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id String @db.Uuid
  file_id String @db.Uuid
  revision Int
  requested_by_id String? @db.Uuid
  reviewer_id String? @db.Uuid
  status TeamReviewStatus @default(PENDING)
  request_note String @default("") @db.VarChar(1000)
  response_note String @default("") @db.VarChar(1000)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  responded_at DateTime? @db.Timestamptz(6)
  team team_spaces @relation(fields: [team_id], references: [id], onDelete: Cascade)
  file files @relation(fields: [file_id], references: [id], onDelete: Cascade)
  requester users? @relation("TeamReviewRequester", fields: [requested_by_id], references: [id], onDelete: SetNull)
  reviewer users? @relation("TeamReviewReviewer", fields: [reviewer_id], references: [id], onDelete: SetNull)
  @@index([team_id, created_at, id])
  @@index([file_id, revision, reviewer_id, status])
  @@index([requested_by_id])
  @@index([reviewer_id])
}

// Kept after account deletion so filesystem cleanup survives crashes and retries.
model user_deletion_jobs {
  user_id String @id @db.Uuid
  upload_ids String[] @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model users {
  owned_teams team_spaces[] @relation("OwnedTeams")
  team_memberships team_members[] @relation("TeamMemberships")
  team_invitations team_invitations[]
  team_messages team_messages[]
  team_chat_reads team_chat_reads[]
  team_chat_mentions team_chat_mentions[]
  created_team_tasks team_tasks[] @relation("TeamTaskCreator")
  assigned_team_tasks team_tasks[] @relation("TeamTaskAssignee")
  requested_team_reviews team_file_reviews[] @relation("TeamReviewRequester")
  assigned_team_reviews team_file_reviews[] @relation("TeamReviewReviewer")
  role          UserRole  @default(USER)
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String    @unique @db.VarChar(50)
  email         String?   @unique @db.VarChar(255)
  password_hash String
  storage_limit BigInt?   @default(10485760)
  storage_used  BigInt?   @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  files        files[]
  folders      folders[]
  notes        notes[]
  favorites    favorites[]
  shared_items shared_items[]
  trash trash[]
  file_requests file_requests[]
  file_versions file_versions[]
  file_scans file_scans[]
  activity_entries activity_entries[]
  note_versions note_versions[]
  admin_events admin_events[]
}

model admin_events {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id String? @db.Uuid
  actor_username String @db.VarChar(50)
  target_user_id String @db.Uuid
  target_username String @db.VarChar(50)
  action String @db.VarChar(32)
  role_before UserRole?
  role_after UserRole?
  quota_before BigInt?
  quota_after BigInt?
  created_at DateTime @default(now()) @db.Timestamptz(3)
  users users? @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  @@index([created_at, id])
  @@index([actor_id, created_at])
  @@index([target_user_id, created_at])
}

model activity_entries {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  item_id String? @db.Uuid
  item_type String @db.VarChar(16)
  action String @db.VarChar(32)
  name String @db.VarChar(255)
  previous_name String? @db.VarChar(255)
  location String? @db.VarChar(255)
  request_key String? @unique @db.VarChar(180)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id, created_at, id])
  @@index([user_id, item_type, item_id])
}

model file_scans {
  storage_key String @id
  user_id String @db.Uuid
  status String @default("unscanned") @db.VarChar(16)
  signature String?
  sha256 String? @db.VarChar(64)
  threat String? @db.VarChar(255)
  message String? @db.VarChar(255)
  checked_at DateTime? @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  claim String? @db.Uuid
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id, status])
}

model files {
  hidden Boolean @default(false)
  tags String[] @default([]) @db.VarChar(32)
  revision Int @default(1)
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  folder_id     String?   @db.Uuid
  name          String    @db.VarChar(255)
  original_name String    @db.VarChar(255)
  mime_type     String?   @db.VarChar(150)
  size          BigInt    @default(0)
  storage_key   String
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  technical_metadata Json? @db.JsonB
  metadata_checked_at DateTime? @db.Timestamptz(6)
  metadata_signature String?

  folders   folders?    @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_files_folder")
  users     users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_files_user")
  favorites favorites[]
  request_uploads request_uploads[]
  team_messages team_messages[]
  team_file_reviews team_file_reviews[]
}

model file_versions {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  file_id String @db.Uuid
  revision Int
  name String @db.VarChar(255)
  mime_type String? @db.VarChar(150)
  size BigInt
  storage_key String @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@unique([file_id, revision])
  @@index([user_id, file_id])
}

model file_requests {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  folder_id String? @db.Uuid
  title String @db.VarChar(120)
  description String @default("") @db.VarChar(1000)
  token String @unique @db.VarChar(120)
  is_open Boolean @default(true)
  expires_at DateTime? @db.Timestamptz(6)
  max_file_size Int @default(10485760)
  max_files Int @default(100)
  received_count Int @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploads request_uploads[]

  @@index([user_id, created_at])
}

model request_uploads {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String @db.Uuid
  file_id String? @db.Uuid
  name String @db.VarChar(255)
  sender_name String @default("") @db.VarChar(100)
  sender_note String @default("") @db.VarChar(1000)
  size BigInt
  status String @default("pending") @db.VarChar(20)
  storage_key String?
  mime_type String? @db.VarChar(150)
  reviewed_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  request file_requests @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file files? @relation(fields: [file_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([request_id, created_at])
  @@index([request_id, status])
}

model upload_sessions {
  id String @id @db.Uuid
  user_id String @db.Uuid
  request_id String? @db.Uuid
  access_hash String @db.VarChar(64)
  manifest Json @db.JsonB
  offsets Json @db.JsonB
  total_size BigInt
  result Json? @db.JsonB
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, expires_at])
  @@index([expires_at])
}

model folders {
  hidden Boolean @default(false)
  team_space team_spaces?
  tags String[] @default([]) @db.VarChar(32)
  // Partial unique indexes for root/child names are maintained in migration SQL.
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  parent_folder_id String?   @db.Uuid
  name             String    @db.VarChar(255)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  files         files[]
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_folders_user")
  folders       folders?    @relation("foldersTofolders", fields: [parent_folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_parent_folder")
  other_folders folders[]   @relation("foldersTofolders")
  notes         notes[]
  favorites     favorites[]
}

model notes {
  hidden Boolean @default(false)
  revision Int @default(1)
  tags String[] @default([]) @db.VarChar(32)
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  folder_id  String?   @db.Uuid
  title      String    @db.VarChar(255)
  content    String    @default("")
  size       BigInt    @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  folders   folders?    @relation(fields: [folder_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notes_folder")
  users     users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notes_user")
  favorites favorites[]
}

// No note FK: history survives moving the original note into Trash.
model note_versions {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  note_id String @db.Uuid
  revision Int
  title String @db.VarChar(255)
  content String
  size BigInt
  created_at DateTime @default(now()) @db.Timestamptz(3)
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@unique([note_id, revision])
  @@index([user_id, note_id])
}

model favorites {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  file_id    String?   @db.Uuid
  folder_id  String?   @db.Uuid
  note_id    String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)

  users   users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  files   files?   @relation(fields: [file_id], references: [id], onDelete: Cascade)
  folders folders? @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  notes   notes?   @relation(fields: [note_id], references: [id], onDelete: Cascade)

  @@unique([user_id, file_id])
  @@unique([user_id, folder_id])
  @@unique([user_id, note_id])
}

model shared_items {
  max_downloads Int?
  download_count Int @default(0)
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  item_id    String   @db.Uuid
  item_type  String   @db.VarChar(20)
  token      String   @unique @db.VarChar(120)
  created_at DateTime @default(now()) @db.Timestamp(6)
  password_hash String?
  expires_at DateTime? @db.Timestamptz(6)
  access_version String @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  daily_stats share_daily_stats[]
  event_keys share_event_keys[]

  @@unique([user_id, item_type, item_id])
}


model share_daily_stats {
  share_id String @db.Uuid
  day DateTime @db.Date
  views BigInt @default(0)
  downloads BigInt @default(0)
  last_viewed_at DateTime? @db.Timestamptz(6)
  last_downloaded_at DateTime? @db.Timestamptz(6)
  share shared_items @relation(fields: [share_id], references: [id], onDelete: Cascade)
  @@id([share_id, day])
}

model share_event_keys {
  share_id String @db.Uuid
  key String @db.VarChar(64)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  share shared_items @relation(fields: [share_id], references: [id], onDelete: Cascade)
  @@id([share_id, key])
  @@index([created_at])
}

model trash {
  hidden Boolean @default(false)
  tags String[] @default([]) @db.VarChar(32)
  revision Int @default(1)
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  item_id       String    @db.Uuid
  item_type     String    @db.VarChar(20)

  name          String?   @db.VarChar(255)
  original_name String?   @db.VarChar(255)
  mime_type     String?   @db.VarChar(150)
  size          BigInt?
  storage_key   String?
  folder_id     String?   @db.Uuid
  parent_folder_id String? @db.Uuid
  root_folder_id String? @db.Uuid

  content       String?
  deleted_at    DateTime  @default(now()) @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, item_type, item_id])
  @@index([user_id])
}
